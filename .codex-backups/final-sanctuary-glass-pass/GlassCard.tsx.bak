import React from 'react';
import { StyleSheet, View, ViewStyle } from 'react-native';
import { BlurView } from 'expo-blur';
import { LinearGradient } from 'expo-linear-gradient';

interface GlassCardProps {
  children: React.ReactNode;
  radius?: number;
  borderStyle?: 'normal' | 'gold';
  style?: ViewStyle;
  intensity?: number;
  fillColor?: string;
  hazeColor?: string;
}

function getRgbaAlpha(color: string, fallback: number) {
  const match = color.match(/rgba\([^,]+,\s*[^,]+,\s*[^,]+,\s*([\d.]+)\)/);
  return match ? Number(match[1]) : fallback;
}

export default function GlassCard({
  children,
  radius = 20,
  borderStyle = 'normal',
  style,
  intensity = 24,
  fillColor = 'rgba(5, 4, 14, 0.20)',
  hazeColor = 'rgba(255, 255, 255, 0.016)',
}: GlassCardProps) {
  const isNavBar = radius === 0;
  const sourceFillAlpha = getRgbaAlpha(fillColor, 0.2);
  const sourceHazeAlpha = getRgbaAlpha(hazeColor, 0.016);
  const isHeroGlass = !isNavBar && sourceFillAlpha <= 0.27;
  const effectiveIntensity = isNavBar ? intensity : Math.min(intensity, 24);
  const glowColor = borderStyle === 'gold'
    ? 'rgba(255, 224, 150, 0.24)'
    : isHeroGlass
      ? 'rgba(255, 226, 168, 0.20)'
      : 'rgba(255, 226, 168, 0.20)';
  const glowStyle = isNavBar
    ? undefined
    : {
        boxShadow: isHeroGlass
          ? `0 0 16px rgba(255, 255, 255, 0.075), 0 0 26px ${glowColor}, 0 14px 42px rgba(0, 0, 0, 0.54)`
          : `0 0 15px rgba(255, 255, 255, 0.07), 0 0 28px ${glowColor}, 0 12px 38px rgba(0, 0, 0, 0.47)`,
      } as ViewStyle;
  const effectiveFillColor = isNavBar
    ? fillColor
    : isHeroGlass
      ? `rgba(9, 6, 16, ${Math.min(0.39, Math.max(0.35, sourceFillAlpha * 1.20)).toFixed(3)})`
      : `rgba(5, 4, 14, ${Math.min(0.46, Math.max(0.34, sourceFillAlpha * 0.88)).toFixed(3)})`;
  const effectiveHazeColor = isNavBar
    ? hazeColor
    : `rgba(255, 255, 255, ${Math.min(0.018, Math.max(0.011, sourceHazeAlpha * 0.34)).toFixed(3)})`;
  const borderColor = borderStyle === 'gold'
    ? 'rgba(255, 233, 160, 0.13)'
    : isHeroGlass
      ? 'rgba(255, 244, 210, 0.15)'
      : 'rgba(255, 255, 255, 0.078)';

  return (
    <View style={[styles.outerContainer, { borderRadius: radius }, glowStyle, style]}>
      {/* Container with subtle rim border */}
      <View style={[styles.borderContainer, { borderRadius: radius, borderColor, borderWidth: 1 }]}>
        
        {/* Backdrop blur supports the pane; opacity and light do the visual work. */}
        <BlurView intensity={effectiveIntensity} tint="dark" style={[StyleSheet.absoluteFill, { borderRadius: radius }]} />
        
        {/* Smoked translucent fill */}
        <View style={[StyleSheet.absoluteFill, { borderRadius: radius, backgroundColor: effectiveFillColor }]} />

        {/* Milky frost haze */}
        <View style={[StyleSheet.absoluteFill, { borderRadius: radius, backgroundColor: effectiveHazeColor }]} />
        
        {/* Diagonal glass refraction sheen */}
        <LinearGradient
          colors={['rgba(255, 255, 255, 0.118)', 'rgba(255, 244, 220, 0.014)', 'transparent']}
          start={{ x: 0.05, y: 0.01 }}
          end={{ x: 0.76, y: 0.62 }}
          style={[StyleSheet.absoluteFill, { borderRadius: radius }]}
        />
        
        <LinearGradient
          colors={['rgba(255, 255, 255, 0.12)', 'rgba(255, 255, 255, 0.009)', 'transparent']}
          start={{ x: 0.5, y: 0 }}
          end={{ x: 0.5, y: 0.95 }}
          style={[styles.topWash, { borderRadius: radius }]}
        />

        {/* Warm edge light */}
        <LinearGradient
          colors={['rgba(255, 233, 160, 0.068)', 'rgba(255, 233, 160, 0.006)', 'transparent']}
          start={{ x: 0.5, y: 0 }}
          end={{ x: 0.5, y: 0.75 }}
          style={[StyleSheet.absoluteFill, { borderRadius: radius }]}
        />
        
        {/* Gentle internal milky veil */}
        <LinearGradient
          colors={['rgba(255, 255, 255, 0.016)', 'rgba(255, 255, 255, 0.002)', 'rgba(255, 244, 220, 0.009)']}
          start={{ x: 0, y: 0 }}
          end={{ x: 1, y: 1 }}
          style={[StyleSheet.absoluteFill, { borderRadius: radius }]}
        />
        
        {/* Edge refraction highlight styling */}
        <View style={[StyleSheet.absoluteFill, styles.edgeRefraction, { borderRadius: radius }]} />
        
        {/* Card content */}
        <View style={styles.content}>
          {children}
        </View>
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  outerContainer: {
    backgroundColor: 'transparent',
  },
  borderContainer: {
    overflow: 'hidden',
  },
  edgeRefraction: {
    borderWidth: 1,
    borderColor: 'rgba(255, 255, 255, 0.018)',
    borderTopWidth: 1.2,
    borderTopColor: 'rgba(255, 255, 255, 0.44)',
    borderLeftWidth: 1,
    borderLeftColor: 'rgba(255, 244, 210, 0.12)',
    borderBottomWidth: 1,
    borderBottomColor: 'rgba(255, 233, 160, 0.012)',
  },
  topWash: {
    position: 'absolute',
    top: 0,
    left: 0,
    right: 0,
    bottom: 0,
    opacity: 0.11,
  },
  content: {
    position: 'relative',
    zIndex: 1,
  },
});
